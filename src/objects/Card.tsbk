import Phaser from 'phaser'

export class Card {
    public readonly card: Phaser.GameObjects.Rectangle
    public readonly image: Phaser.GameObjects.Image

    private revealed = false

    constructor(
        scene: Phaser.Scene,
        x: number,
        y: number,
        width: number,
        height: number,
        icon: string
    ) {
        this.card = scene.add.rectangle(
            x,
            y,
            width,
            height,
            0x3498db
        )

        this.image = scene.add.image(
            x,
            y,
            icon
        )

        this.image.setVisible(false)

        this.card.setInteractive()
    }

    reveal() {
        this.revealed = true
        this.card.setFillStyle(0xe74c3c)
        this.image.setVisible(true)
    }

    hide() {
        this.revealed = false
        this.card.setFillStyle(0x3498db)
        this.image.setVisible(false)
    }

    isRevealed() {
        return this.revealed
    }

    onClick(callback: () => void) {
        this.card.on('pointerdown', callback)
    }

    destroy() {
        this.card.destroy()
        this.image.destroy()
    }
}
