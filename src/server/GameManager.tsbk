import Game from '../game/Game'
import PlayerManager from './PlayerManager'
import type { PlayerStats } from './PlayerManager'

export default class GameManager {
    private game: Game
    private broadcastState: () => void
    private broadcastRanking: () => void
    private playerManager: PlayerManager

    constructor(
        game: Game,
        broadcastState: () => void,
        broadcastRanking: () => void,
        playerManager: PlayerManager,
    ) {
        this.game = game
        this.broadcastState = broadcastState
        this.broadcastRanking = broadcastRanking
        this.playerManager = playerManager
    }

    flipCard(
        index: number,
        playerId: string
    ): PlayerStats | null {
        if (this.game.revealed.length >= 2) {
            console.log(
                'Rejected: 2 cards already revealed'
            )
            return null
        }

        if (this.game.revealed.includes(index)) {
            console.log(
                'Rejected: card already revealed'
            )
            return null
        }

        if (this.game.matched.includes(index)) {
            console.log(
                'Rejected: card already matched'
            )
            return null
        }

        this.game.revealed.push(index)

        console.log(
            'Revealed:',
            this.game.revealed
        )

        if (this.game.revealed.length === 2) {
            this.checkMatch(playerId)
        }

        this.broadcastState()

        return null
    }

    private checkMatch(
        playerId: string
    ): PlayerStats | null {
        const [first, second] =
            this.game.revealed

        const firstCard =
            this.game.cards[first]

        const secondCard =
            this.game.cards[second]

        if (
            firstCard.pairId ===
            secondCard.pairId
        ) {
            console.log('MATCH!')

            const player =
                this.playerManager.addMatch(
                    playerId
                )

            this.broadcastRanking()

            this.game.matched.push(
                first,
                second
            )

            this.game.revealed = []

            if (
                this.game.matched.length ===
                this.game.cards.length
            ) {
                this.completeGame()
            }

            return player
        }

        console.log('NO MATCH')

        setTimeout(() => {
            this.game.revealed = []
            this.broadcastState()
        }, 800)

        return null
    }

    private completeGame() {
        console.log('GAME COMPLETE!')

        setTimeout(() => {
            this.game.revealed = []
            this.game.matched = []

            this.game.cards.sort(
                () => Math.random() - 0.5
            )

            console.log(
                'NEW GAME:',
                this.game.cards
                    .map(card => card.partId)
                    .join(' ')
            )

            this.broadcastState()
        }, 1000)
    }
}
